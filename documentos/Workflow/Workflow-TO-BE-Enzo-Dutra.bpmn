<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_TO_BE" targetNamespace="http://example.org/estagio/workflow" exporter="Codex" exporterVersion="1.0">
  <bpmn:process id="Process_TO_BE" name="Venda e controle de estoque - TO-BE" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TO_BE">
      <bpmn:lane id="Lane_Cliente" name="Cliente">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WantOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNoOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CustomerReceive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CustomerPay</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proprietario" name="Proprietário">
        <bpmn:flowNodeRef>ConsultStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InformUnavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PlaceOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WaitDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OwnerReceive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UpdateStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OwnerReceivePay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectClient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RegisterSale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndSale</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Sistema">
        <bpmn:flowNodeRef>ShowStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SystemUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SaveSale</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Fornecedor" name="Fornecedor">
        <bpmn:flowNodeRef>SupplierReceive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SupplierShip</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Início">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="Request" name="Solicitar produto">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="ConsultStock" name="Consultar estoque no sistema">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ShowStock" name="Exibir quantidade disponível">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Available" name="Produto disponível?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Confirm" name="Confirmar compra">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="InformUnavailable" name="Informar indisponibilidade">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="WantOrder" name="Deseja encomendar?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndNoOrder" name="Fim">
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="PlaceOrder" name="Realizar pedido ao fornecedor">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="SupplierReceive" name="Receber pedido">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="SupplierShip" name="Enviar produto">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="WaitDelivery" name="Aguardar 2 a 3 semanas">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDefinition_Delivery" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="OwnerReceive" name="Receber produto do fornecedor">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="UpdateStock" name="Atualizar estoque no sistema">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="SystemUpdate" name="Salvar quantidade em estoque">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Merge">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Deliver" name="Entregar produto">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="CustomerReceive" name="Receber produto">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="CustomerPay" name="Efetuar pagamento">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="OwnerReceivePay" name="Receber pagamento">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="SelectClient" name="Selecionar cliente ou informar novo nome">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="RegisterSale" name="Informar dados e registrar venda">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="SaveSale" name="Cadastrar cliente novo, registrar venda e baixar estoque">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndSale" name="Fim">
      <bpmn:incoming>F25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Request" />
    <bpmn:sequenceFlow id="F2" sourceRef="Request" targetRef="ConsultStock" />
    <bpmn:sequenceFlow id="F3" sourceRef="ConsultStock" targetRef="ShowStock" />
    <bpmn:sequenceFlow id="F4" sourceRef="ShowStock" targetRef="Available" />
    <bpmn:sequenceFlow id="F5" name="Sim" sourceRef="Available" targetRef="Confirm" />
    <bpmn:sequenceFlow id="F6" name="Não" sourceRef="Available" targetRef="InformUnavailable" />
    <bpmn:sequenceFlow id="F7" sourceRef="InformUnavailable" targetRef="WantOrder" />
    <bpmn:sequenceFlow id="F8" name="Não" sourceRef="WantOrder" targetRef="EndNoOrder" />
    <bpmn:sequenceFlow id="F9" name="Sim" sourceRef="WantOrder" targetRef="PlaceOrder" />
    <bpmn:sequenceFlow id="F10" sourceRef="PlaceOrder" targetRef="SupplierReceive" />
    <bpmn:sequenceFlow id="F11" sourceRef="SupplierReceive" targetRef="SupplierShip" />
    <bpmn:sequenceFlow id="F12" sourceRef="SupplierShip" targetRef="WaitDelivery" />
    <bpmn:sequenceFlow id="F13" sourceRef="WaitDelivery" targetRef="OwnerReceive" />
    <bpmn:sequenceFlow id="F14" sourceRef="OwnerReceive" targetRef="UpdateStock" />
    <bpmn:sequenceFlow id="F15" sourceRef="UpdateStock" targetRef="SystemUpdate" />
    <bpmn:sequenceFlow id="F16" sourceRef="SystemUpdate" targetRef="Merge" />
    <bpmn:sequenceFlow id="F17" sourceRef="Confirm" targetRef="Merge" />
    <bpmn:sequenceFlow id="F18" sourceRef="Merge" targetRef="Deliver" />
    <bpmn:sequenceFlow id="F19" sourceRef="Deliver" targetRef="CustomerReceive" />
    <bpmn:sequenceFlow id="F20" sourceRef="CustomerReceive" targetRef="CustomerPay" />
    <bpmn:sequenceFlow id="F21" sourceRef="CustomerPay" targetRef="OwnerReceivePay" />
    <bpmn:sequenceFlow id="F22" sourceRef="OwnerReceivePay" targetRef="SelectClient" />
    <bpmn:sequenceFlow id="F23" sourceRef="SelectClient" targetRef="RegisterSale" />
    <bpmn:sequenceFlow id="F24" sourceRef="RegisterSale" targetRef="SaveSale" />
    <bpmn:sequenceFlow id="F25" sourceRef="SaveSale" targetRef="EndSale" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_TO_BE">
    <bpmndi:BPMNPlane id="Plane_TO_BE" bpmnElement="Process_TO_BE">
      <bpmndi:BPMNShape id="Shape_Lane_Cliente" bpmnElement="Lane_Cliente" isHorizontal="true"><dc:Bounds x="30" y="30" width="4880" height="190" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Proprietario" bpmnElement="Lane_Proprietario" isHorizontal="true"><dc:Bounds x="30" y="220" width="4880" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Sistema" bpmnElement="Lane_Sistema" isHorizontal="true"><dc:Bounds x="30" y="420" width="4880" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Fornecedor" bpmnElement="Lane_Fornecedor" isHorizontal="true"><dc:Bounds x="30" y="600" width="4880" height="230" /></bpmndi:BPMNShape>
