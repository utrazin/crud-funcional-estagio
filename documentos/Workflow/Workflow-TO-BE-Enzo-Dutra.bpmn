      <bpmndi:BPMNShape id="Shape_OwnerReceivePay" bpmnElement="OwnerReceivePay"><dc:Bounds x="3790" y="245" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SelectClient" bpmnElement="SelectClient"><dc:Bounds x="4020" y="245" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_RegisterSale" bpmnElement="RegisterSale"><dc:Bounds x="4270" y="245" width="190" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SaveSale" bpmnElement="SaveSale"><dc:Bounds x="4520" y="455" width="210" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndSale" bpmnElement="EndSale"><dc:Bounds x="4800" y="272" width="36" height="36" /></bpmndi:BPMNShape>
