      <bpmndi:BPMNShape id="Shape_EndNoOrder" bpmnElement="EndNoOrder"><dc:Bounds x="1400" y="112" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PlaceOrder" bpmnElement="PlaceOrder"><dc:Bounds x="1460" y="340" width="175" height="65" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SupplierReceive" bpmnElement="SupplierReceive"><dc:Bounds x="1690" y="665" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SupplierShip" bpmnElement="SupplierShip"><dc:Bounds x="1910" y="665" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_WaitDelivery" bpmnElement="WaitDelivery"><dc:Bounds x="2130" y="353" width="48" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_OwnerReceive" bpmnElement="OwnerReceive"><dc:Bounds x="2250" y="340" width="170" height="65" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UpdateStock" bpmnElement="UpdateStock"><dc:Bounds x="2480" y="340" width="170" height="65" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SystemUpdate" bpmnElement="SystemUpdate"><dc:Bounds x="2730" y="465" width="175" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Merge" bpmnElement="Merge"><dc:Bounds x="2990" y="280" width="50" height="50" /></bpmndi:BPMNShape>
