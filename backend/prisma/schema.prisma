generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("Proprietário/Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Product {
  id            String    @id @default(cuid())
  name          String
  price         Float
  stockQuantity Int       @default(0)
  salesCount    Int       @default(0)
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  sales Sale[]

  @@map("products")
}

model Client {
  id                     String    @id @default(cuid())
  name                   String
  cellphone              String?
  totalPurchases         Int       @default(0)
  totalProductsPurchased Int       @default(0)
  totalSpent             Float     @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  sales Sale[]

  @@map("clients")
}

model Sale {
  id         String    @id @default(cuid())
  productId  String
  clientId   String
  quantity   Int
  unitPrice  Float
  totalPrice Float
  saleDate   DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime?
  deletedAt  DateTime?

  product Product @relation(fields: [productId], references: [id])
  client  Client  @relation(fields: [clientId], references: [id])

  @@map("sales")
}
